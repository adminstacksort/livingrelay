NODE_ENV=production
APP_ENV=production
SERVER_PORT=8787
APP_PUBLIC_URL=https://livingrelay.com
SESSION_SECRET=replace-with-random-32-byte-secret
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GA_MEASUREMENT_ID=

# Postgres / AWS RDS
DATABASE_URL=postgres://user:password@host:5432/livingrelay
DATABASE_SSL=true

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_MESSAGING_NUMBER=+14159658795

# AI triage/vendor search
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional voice vendor outreach
ENABLE_VENDOR_CALLS=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
VENDOR_CALL_TEST_MODE=true
VENDOR_CALL_TEST_NUMBER=
VENDOR_CALL_PROVIDER=twilio_register
TWILIO_VOICE_NUMBER=
TWILIO_MEDIA_STREAM_URL=
INBOUND_EMAIL_ADDRESS=invoices@livingrelay.com

# Stripe coordination-fee billing
