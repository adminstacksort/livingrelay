{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run build",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "aws:https": "node scripts/provision-aws-https.mjs",
    "start": "node server/index.js",
    "smoke": "node scripts/smoke-health.mjs",
    "readiness": "node -e \"fetch('http://127.0.0.1:'+(process.env.SERVER_PORT||8787)+'/api/readiness').then(async r=>{console.log(await r.text()); process.exit(r.ok?0:1)}).catch(e=>{console.error(e); process.exit(1)})\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "pg": "^8.20.0",
    "react": "latest",
    "react-dom": "latest",
    "twilio": "^6.0.0",
    "vite": "latest",
    "ws": "^8.20.0"
  }
}
